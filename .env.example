# Скопируйте в .env.local и заполните из панели Supabase (Settings → API).
# Игра работает и без этих переменных: single-player полностью локальный,
# профиль хранит историю в localStorage, мультиплеер скрыт.
# Используются ТОЛЬКО публичные anon-ключи — service_role ключи сюда не добавлять.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
